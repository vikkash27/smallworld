# Copy to .env and fill the values there. .env is gitignored.

# Structured rerank. Model id is OpenAI's gpt-6.1-sol.
# Leave the key empty to keep discovery on the deterministic local matcher.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Cognee Cloud. Copy the API base URL and tenant id from the API Keys page.
# Leave these empty to keep retrievalBackend as local.
COGNEE_ENABLED=true
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=

# App. Track C owns storage and auth and is not on Supabase.
# Add their env names when that alternative lands. Intelligence does not open a database.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DATA_MODE=mock
